# Root scripts only (scripts/db/setup-local.sh, Prism). Copy to .env; never commit .env.
# Per-app settings live in each app's own example file:
#   apps/api/.env.example            Laravel (DB, JWT, CORS, AI service key, ...)
#   apps/ai-service/.env.example     FastAPI (internal key, model dir, ...)
#   apps/web-ops/.env.example        VITE_API_BASE_URL, VITE_MAP_TILE_URL, VITE_MAP_TILE_URL_DARK
#   apps/web-admin/.env.example      VITE_API_BASE_URL
#   apps/mobile-*/.env.example       EXPO_PUBLIC_API_BASE_URL, light/dark map style URLs

# PostgreSQL superuser used only by scripts/db/setup-local.sh to create the role,
# databases and the PostGIS extension. Its password is read from PGPASSWORD or
# your pgpass file, never from this file.
PG_SUPERUSER=postgres
PG_HOST=127.0.0.1
PG_PORT=5432

# Prism mock of docs/api/openapi.yaml (pnpm mock:api)
PRISM_PORT=4010
