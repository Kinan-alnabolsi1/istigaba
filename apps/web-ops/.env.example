# web-ops (Vite). Only VITE_* variables reach the browser: never put secrets here.
# Real API: http://127.0.0.1:8000/api/v1   Prism mock (pnpm mock:api): http://127.0.0.1:4010
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Map tiles (S3). Dark falls back to the light URL when unset.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL_DARK=
