# Istigaba AI service (FastAPI). Copy to .env; never commit .env.
# Shared secret that Laravel sends in X-Internal-Key. Use a long random value; the same value
# goes into apps/api/.env when the Laravel AI client is added (S8).
AI_INTERNAL_KEY=
# Directory with model weights, outside git (one copy only; disk is limited).
AI_MODELS_DIR=
# Reported as model_version in /extract responses (S8).
AI_MODEL_VERSION=unset
