{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "istigaba/api",
    "type": "project",
    "description": "Istigaba emergency reporting and response platform API (Laravel 13 modular monolith).",
    "keywords": [
        "istigaba",
        "emergency",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.44",
        "laravel/tinker": "^3.0",
        "matanyadaev/laravel-eloquent-spatial": "^4.8",
        "php-open-source-saver/jwt-auth": "2.10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "laravel/telescope": "^5.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "osteel/openapi-httpfoundation-testing": "^0.15",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.22"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
