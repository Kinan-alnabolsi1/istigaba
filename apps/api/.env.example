APP_NAME=Istigaba
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# API messages are localized by Accept-Language: ar (default) or en.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# JSON daily logs with request_id and central redaction (CLAUDE.md §11, H6).
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# PostgreSQL 18 + PostGIS 3.7. Create the role/databases with: pnpm db:setup
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=istigaba
DB_USERNAME=istigaba
DB_PASSWORD=
# Test database (used by phpunit.xml; tests refuse any DB whose name does not end in _test)
DB_TEST_DATABASE=istigaba_test

# Stateless JWT API: no server sessions.
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local dev uses the database driver (framework tables allowlisted, decision B2). Production: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@istigaba.example"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: comma-separated origins of the web apps (no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Telescope runs only when APP_ENV=local.
TELESCOPE_ENABLED=true

# S1 Identity (NFR-006). Generate the secret locally with `php artisan jwt:secret`; never commit it.
JWT_SECRET=
JWT_TTL=15
REFRESH_TOKEN_TTL_DAYS=30

# First System Administrator (database/seeders/FirstAdminSeeder.php). The seeder refuses the
# example password and passwords shorter than 8 characters when APP_ENV=production.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=change-me-admin

# Rate limits and login lockout (config/rate-limits.php) use the approved defaults; override only
# if needed, e.g. RATE_LOGIN_PER_MINUTE=10, LOGIN_LOCKOUT_MAX_FAILURES=5, LOGIN_LOCKOUT_MINUTES=15.
