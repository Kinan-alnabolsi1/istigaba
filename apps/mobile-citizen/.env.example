# mobile-citizen (Expo). Only EXPO_PUBLIC_* variables reach the app bundle: never put secrets here.
# Android emulator reaches the host as 10.0.2.2; a physical device needs the PC's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# MapLibre style URLs (S3)
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL_DARK=
