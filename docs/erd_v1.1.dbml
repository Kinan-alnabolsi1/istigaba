// =====================================================================
// منصة «استجابة» - ERD منطقي - الإصدار 1.1
// متوافق مع وثيقة SRS الإصدار 1.1
// الصق الملف كاملاً في https://dbdiagram.io/d
// =====================================================================

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

// دورة حياة البلاغ (SRS القسم 7)
Enum report_status {
  received          [note: 'استُلم']
  under_review      [note: 'قيد المراجعة']
  assigned          [note: 'حُوّل إلى وحدة']
  en_route          [note: 'الوحدة في الطريق']
  on_site           [note: 'في الموقع']
  mission_completed [note: 'اكتملت المهمة']
  closed            [note: 'أُغلق']
}

// حالة المهمة الميدانية (FR-032). القيم تطابق report_status
// وتزيد cancelled لحالة إعادة الإسناد.
Enum mission_status {
  assigned
  en_route
  on_site
  mission_completed
  cancelled
}

Enum severity_level {
  low
  medium
  high
  critical
}

Enum report_source {
  sos
  manual
  ai_bot
}

Enum input_mode {
  text
  voice
}

Enum extraction_status {
  pending_review
  edited
  confirmed
  cancelled
}

Enum notification_type {
  status_update
  assignment
  closure
  geographic_alert
}

Enum unit_availability {
  available
  busy
  offline
}

// ---------------------------------------------------------------------
// 1) الحسابات والصلاحيات (FR-001 إلى FR-004، NFR-006، NFR-007)
// ---------------------------------------------------------------------

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique, note: 'Citizen | Dispatcher | Field Unit Representative | System Administrator']
  description varchar(255)
}

Table permissions {
  id int [pk, increment]
  code varchar(100) [not null, unique, note: 'مثل report.assign و report.close و identity.reveal']
  description varchar(255)
}

Table role_permissions {
  role_id int [not null, ref: > roles.id]
  permission_id int [not null, ref: > permissions.id]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id int [not null, ref: > roles.id]
  field_unit_id int [ref: > field_units.id, note: 'إلزامي لدور Field Unit Representative فقط، ويُتحقق منه في التطبيق']
  full_name varchar(150) [not null]
  email varchar(255) [not null, unique]
  phone varchar(30) [unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  last_known_location geography(Point,4326) [note: 'آخر موقع معروف. يُستخدم في FR-012 و FR-027']
  location_updated_at timestamptz
  location_consent boolean [not null, default: false, note: 'إذن المستخدم بمشاركة الموقع (FR-027)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    role_id
    field_unit_id
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar(255) [not null, unique, note: 'تُخزَّن بصيغة hash وليس النص الصريح']
  expires_at timestamptz [not null]
  revoked_at timestamptz [note: 'يُملأ عند تسجيل الخروج (FR-003)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

// ---------------------------------------------------------------------
// 2) البلاغات (FR-006 إلى FR-010، FR-019 إلى FR-024، FR-028)
// ---------------------------------------------------------------------

Table report_types {
  id int [pk, increment]
  category varchar(50) [not null, note: 'الطوارئ المدنية | الحوادث المرورية | البلاغات الأمنية | المخاطر الصحية (FR-008)']
  name varchar(100) [not null, note: 'حريق، تسرب غاز، سرقة، مفقود... ويشمل نوع «SOS عام» الجاهز']
  responsible_authority varchar(100) [not null, note: 'الجهة المقترحة. التكامل معها محاكاة (FR-039)']

  indexes {
    (category, name) [unique]
  }
}

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  reporter_id uuid [not null, ref: > users.id, note: 'مملوء دائماً حتى لو كان البلاغ مجهولاً. الإخفاء يتم في طبقة الـ API (FR-009)']
  report_type_id int [not null, ref: > report_types.id]
  source report_source [not null]
  is_anonymous boolean [not null, default: false, note: 'لا يُسمح بها إلا للبلاغ اليدوي وبلاغ المساعد الذكي (FR-009)']
  description text
  location geography(Point,4326) [note: 'قد تكون فارغة إن تعذر تحديد الموقع (FR-006)']
  location_text varchar(255)
  severity severity_level
  priority_score numeric(6,2) [note: 'لترتيب القائمة فقط، ولا يلغي قرار المشغل (FR-022)']
  current_status report_status [not null, default: 'received']
  administrative_area varchar(100)
  close_reason text [note: 'إلزامي عند الإغلاق (FR-028)، ويُتحقق منه في التطبيق']
  closed_by uuid [ref: > users.id]
  closed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    current_status
    created_at
    reporter_id
    administrative_area
    report_type_id
  }
}

Table report_timeline {
  id bigint [pk, increment]
  report_id uuid [not null, ref: > reports.id]
  status report_status [not null]
  changed_by uuid [ref: > users.id, note: 'فارغ عندما يكون التغيير من النظام نفسه (الحالة الأولى: received)']
  note text
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, changed_at)
  }
}

Table report_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  file_url varchar(500) [not null, note: 'الملف نفسه في مخزن ملفات خارج قاعدة البيانات']
  file_type varchar(20) [not null, note: 'image | video | audio']
  mime_type varchar(100)
  size_bytes bigint
  uploaded_at timestamptz [not null, default: `now()`]

  Note: 'المرفقات الصوتية هنا تخص البلاغ اليدوي (FR-007) فقط. تسجيلات بوت الإبلاغ الذكي تُحذف بعد التحويل إلى نص (FR-018، NFR-015) ولا تُخزَّن'

  indexes {
    report_id
  }
}

// ---------------------------------------------------------------------
// 3) بوت الإبلاغ الذكي (FR-013 إلى FR-018)
// ---------------------------------------------------------------------

Table ai_extractions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'رابط داخلي فقط. لا تُرسل الهوية لمكوّن الذكاء الاصطناعي (FR-018، NFR-014)']
  report_id uuid [unique, ref: - reports.id, note: 'لا يُملأ إلا بعد التأكيد الصريح من المواطن (FR-017)']
  input_mode input_mode [not null]
  input_text text [note: 'النص الحر، أو نص الصوت بعد التحويل. لا يوجد عمود للملف الصوتي']
  extracted_type_id int [ref: > report_types.id]
  extracted_severity severity_level
  extracted_location_text varchar(255)
  extracted_description text
  is_anonymous boolean [not null, default: false, note: 'اختيار المواطن قبل التأكيد، وينتقل إلى reports عند التأكيد']
  status extraction_status [not null, default: 'pending_review']
  confirmed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    status
  }
}

// ---------------------------------------------------------------------
// 4) الدردشة (FR-025)
// ---------------------------------------------------------------------

Table chat_messages {
  id bigint [pk, increment]
  report_id uuid [not null, ref: > reports.id]
  sender_id uuid [not null, ref: > users.id]
  message text [not null]
  sent_at timestamptz [not null, default: `now()`]

  Note: 'عند البلاغ المجهول يعرض الـ API للمشغل «مبلّغ مجهول» بدل اسم المرسل'

  indexes {
    (report_id, sent_at)
  }
}

// ---------------------------------------------------------------------
// 5) الوحدات الميدانية والإسناد (FR-021، FR-026، FR-031 إلى FR-033)
// ---------------------------------------------------------------------

Table field_units {
  id int [pk, increment]
  name varchar(150) [not null]
  unit_type varchar(50) [not null, note: 'شرطة | دفاع مدني | إسعاف | مرور']
  availability unit_availability [not null, default: 'available']
  location geography(Point,4326)
  location_updated_at timestamptz
}

Table assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  field_unit_id int [not null, ref: > field_units.id]
  assigned_by uuid [not null, ref: > users.id, note: 'المشغل الذي اتخذ القرار (FR-026)']
  mission_status mission_status [not null, default: 'assigned']
  assigned_at timestamptz [not null, default: `now()`]
  en_route_at timestamptz
  on_site_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz [note: 'عند إعادة الإسناد لوحدة أخرى']

  Note: 'قاعدة: إسناد واحد فعّال (غير ملغى) لكل بلاغ. يُنفَّذ بفهرس فريد جزئي في قاعدة البيانات الفعلية'

  indexes {
    report_id
    (field_unit_id, mission_status)
  }
}

Table field_actions {
  id uuid [pk, default: `gen_random_uuid()`]
  assignment_id uuid [not null, ref: > assignments.id]
  submitted_by uuid [not null, ref: > users.id]
  action_taken text [not null]
  attachment_url varchar(500)
  submitted_at timestamptz [not null, default: `now()`]

  indexes {
    assignment_id
  }
}

// ---------------------------------------------------------------------
// 6) التنبيهات والإشعارات (FR-011، FR-012، FR-027، FR-038)
// ---------------------------------------------------------------------

Table geographic_alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by uuid [not null, ref: > users.id]
  title varchar(150) [not null]
  hazard_description text [not null]
  center geography(Point,4326) [not null]
  radius_m int [not null, note: 'نصف القطر بالمتر']
  created_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  type notification_type [not null]
  report_id uuid [ref: > reports.id]
  alert_id uuid [ref: > geographic_alerts.id]
  title varchar(150) [not null]
  body text
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_read)
    created_at
  }
}

// ---------------------------------------------------------------------
// 7) الإدارة والتدقيق والمحاكاة (FR-034 إلى FR-037، FR-039، NFR-010)
// ---------------------------------------------------------------------

Table audit_logs {
  id bigint [pk, increment]
  actor_id uuid [ref: > users.id]
  action varchar(100) [not null, note: 'مثل report.edit و report.close و identity.reveal و user.disable']
  entity_type varchar(50) [not null]
  entity_id varchar(64)
  old_value jsonb
  new_value jsonb
  reason text [note: 'إلزامي عند identity.reveal (FR-037)، ويُتحقق منه في التطبيق']
  ip_address inet
  created_at timestamptz [not null, default: `now()`]

  indexes {
    actor_id
    (entity_type, entity_id)
    action
    created_at
  }
}

Table system_settings {
  key varchar(100) [pk]
  value text [not null]
  description varchar(255)
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'إعدادات عامة (FR-036) مثل مهلة إلغاء SOS (5 ثوانٍ افتراضياً)'
}

Table simulated_integration_logs {
  id bigint [pk, increment]
  assignment_id uuid [not null, ref: > assignments.id]
  authority varchar(100) [not null, note: 'الشرطة | الإسعاف | الدفاع المدني']
  request_payload jsonb
  response_payload jsonb [note: 'رد تجريبي من طبقة المحاكاة (FR-039)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    assignment_id
  }
}
