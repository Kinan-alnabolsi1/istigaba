{
  "name": "@istigaba/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared shadcn/ui components for web-ops and web-admin (Tailwind CSS 4, tokens from @istigaba/config).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./auth": "./src/auth/index.ts",
    "./vite": "./src/theme/head.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "catalog:web",
    "react-dom": "catalog:web"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@istigaba/api-client": "workspace:*",
    "@istigaba/api-types": "workspace:*",
    "@istigaba/config": "workspace:*",
    "@istigaba/i18n": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "i18next": "catalog:",
    "radix-ui": "1.8.1",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axios-mock-adapter": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "typescript": "catalog:",
    "vite": "catalog:web",
    "vitest": "catalog:"
  }
}
